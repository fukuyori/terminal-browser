{
  "name": "terminal-browser",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows-inno.ps1",
    "browser": "pnpm --filter terminal-browser start",
    "types": "node scripts/plugin-types.mjs",
    "postinstall": "node scripts/plugin-types.mjs --if-missing",
    "build:dist": "scripts/release.sh \"local-$(git rev-parse --short HEAD)\"",
    "install:dist": "scripts/install-local.sh",
    "dist": "pnpm build:dist && pnpm install:dist",
    "release:patch": "scripts/tag-release.sh patch",
    "release:minor": "scripts/tag-release.sh minor",
    "release:major": "scripts/tag-release.sh major"
  },
  "packageManager": "pnpm@10.13.1",
  "devDependencies": {
    "@electron/osx-sign": "^1.3.3",
    "esbuild": "^0.25.0"
  },
  "pnpm": {
    "overrides": {
      "@zenbu-labs/pixel-native-win32-x64": "file:../pixel/packages/native/win32-x64"
    }
  }
}
